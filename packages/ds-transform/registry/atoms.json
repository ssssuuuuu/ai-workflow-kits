    "variants": [
      { "axis": "mode", "values": ["single", "multiple"], "default": "single" },
      { "axis": "searchable", "values": ["off", "on"], "default": "off" },
      { "axis": "size", "values": ["sm", "md", "lg"], "default": "md" }
    ],
    "states": ["default", "focus", "open", "filled", "disabled"],
    "compositionApi": "compound",
    "children": ["Select.Option"],
    "accessibility": ["role=combobox/listbox; 옵션은 role=option, 선택 시 aria-selected=true."],
    "consolidates": ["select"],
    "status": "net-new",
    "docsRef": "docs/design-system-methodology.md#1710-input-계열-textfield--textarea--select--switch"
  },
  {
    "name": "Switch",
    "atomicLevel": "atom",
    "description": "즉시 적용되는 이진 on/off 컨트롤. 일부 시스템은 Toggle로 부른다(동일 원자).",
