  },
  {
    "name": "Checkbox",
    "atomicLevel": "atom",
    "description": "선택/미선택/불확정 상태를 가지는 체크박스.",
    "slots": [{ "name": "label", "accepts": "text", "optional": true }],
    "variants": [
      { "axis": "selection", "values": ["unselected", "selected", "indeterminate"], "default": "unselected" }
    ],
    "states": ["default", "hover", "focus", "disabled", "readonly", "error"],
    "accessibility": ["role=checkbox, aria-checked=true|false|mixed(indeterminate)."],
    "consolidates": [],
    "status": "net-new",
    "docsRef": "docs/design-system-methodology.md#176-checkbox--radio-아이템-스펙"
  },
  {
    "name": "Select",
    "atomicLevel": "atom",
    "description": "옵션 목록에서 선택하는 컨트롤. 옵션은 네임스페이스 자식(Select.Option)으로 노출한다.",
    "slots": [
      { "name": "trigger", "accepts": "text | Icon" },
      { "name": "menu", "accepts": "Option", "repeatable": true }
