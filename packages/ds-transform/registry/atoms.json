      { "axis": "selection", "values": ["unselected", "selected"], "default": "unselected" }
    ],
    "states": ["default", "hover", "focus", "disabled", "readonly"],
    "accessibility": ["role=radio, aria-checked; 그룹은 fieldset/legend 또는 RadioGroup으로 묶는다."],
