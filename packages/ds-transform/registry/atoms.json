      { "axis": "tone", "values": ["default", "error", "warning", "success"], "default": "default" }
    ],
    "states": ["default"],
    "accessibility": ["연관 컨트롤과 aria-describedby로 연결. 에러 톤이면 helper 슬롯을 error 메시지로 대체한다."],
