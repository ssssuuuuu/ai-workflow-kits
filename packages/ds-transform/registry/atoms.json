  {
    "name": "Button",
    "atomicLevel": "atom",
    "description": "액션을 실행하는 버튼. 스타일은 kind, 크기는 size 변형으로 통합한다.",
    "slots": [
      { "name": "label", "accepts": "text" },
      { "name": "icon", "accepts": "Icon", "optional": true }
    ],
    "variants": [
      { "axis": "kind", "values": ["primary", "secondary", "tertiary", "ghost", "danger"], "default": "primary" },
      { "axis": "size", "values": ["sm", "md", "lg"], "default": "md" }
    ],
    "states": ["default", "hover", "focus", "active", "disabled", "loading"],
    "tokens": [{ "name": "button-primary-background", "references": "color-brand-primary" }],
    "compositionApi": "props",
    "accessibility": ["role=button; loading 시 aria-busy=true; 아이콘 전용은 IconButton을 쓴다."],
    "consolidates": ["btn1 (→ kind=primary)", "btn2 (→ kind=secondary)"],
    "status": "net-new",
    "docsRef": "docs/design-system-methodology.md#177-button-아이템-스펙"
  },
  {
    "name": "IconButton",
    "atomicLevel": "atom",
    "description": "아이콘만 있는 버튼.",
