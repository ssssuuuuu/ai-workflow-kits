    "variants": [
      { "axis": "state", "values": ["off", "on"], "default": "off" },
      { "axis": "size", "values": ["sm", "md"], "default": "md" }
    ],
    "states": ["default", "hover", "focus", "disabled", "readonly"],
    "accessibility": ["role=switch, aria-checked; 즉시 적용(별도 제출 불필요) — 제출형 다중선택은 Checkbox를 쓴다."],
    "consolidates": ["switch", "toggle"],
    "status": "net-new",
    "docsRef": "docs/design-system-methodology.md#1710-input-계열-textfield--textarea--select--switch"
  },
  {
    "name": "Icon",
    "atomicLevel": "atom",
