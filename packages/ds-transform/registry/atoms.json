    "variants": [
      { "axis": "type", "values": ["text", "number", "password", "email", "search", "tel"], "default": "text" },
      { "axis": "size", "values": ["sm", "md", "lg"], "default": "md" },
      { "axis": "style", "values": ["outlined", "filled"], "default": "outlined" }
    ],
    "states": ["default", "focus", "filled", "error", "disabled", "readonly"],
    "accessibility": ["label과 for/id로 연결; 에러 시 aria-invalid=true + aria-describedby로 helper를 연결한다."],
