    "variants": [
      { "axis": "size", "values": ["sm", "md", "lg"], "default": "md" },
      { "axis": "shape", "values": ["square", "circle"], "default": "square" }
    ],
    "states": ["default", "hover", "focus", "disabled"],
    "accessibility": ["텍스트 라벨이 없으므로 aria-label이 필수다."],
    "consolidates": [],
    "status": "net-new",
    "docsRef": "docs/design-system-methodology.md#177-button-아이템-스펙"
  },
  {
    "name": "Input",
    "atomicLevel": "atom",
    "description": "단일행 입력 필드. 숫자 입력은 type=number 변형으로 통합한다.",
    "slots": [
      { "name": "label", "accepts": "text", "optional": true },
